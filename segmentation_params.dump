x-column = "x_location"
nuclei-genes = ""
scale-std = "25%"
save-polygons = ""
iters = 500
scale = ""
force-2d = false
new-component-fraction = 0.3
coordinates = "X0.0-24000.0_Y0.0-24000.0_filtered_transcripts.csv"
num-cells-init = ""
exclude-genes = ""
config = ""
prior-segmentation-confidence = 0.5
min-molecules-per-gene = 1
y-column = "y_location"
cyto-genes = ""
min-molecules-per-cell = 1
n-clusters = 4
new-component-weight = 0.2
plot = true
gene-column = "feature_name"
prior_segmentation = ":cell_id"
z-column = "z_location"
